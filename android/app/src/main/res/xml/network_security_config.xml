<?xml version="1.0" encoding="utf-8"?>
<!--
  明文（HTTP）流量策略。

  为什么不能简单把 usesCleartextTraffic 设成 false：
  本 App 支持「连电脑端后端」模式，地址由用户在设置里填（形如
  http://192.168.1.20:8787）。局域网后端就是裸 HTTP，禁掉明文会让这个功能直接不可用；
  而 Android 的 network-security-config 只支持逐个域名/IP，不支持 192.168.0.0/16 这类
  网段通配，所以没法「只允许内网明文」。

  所以这里采取「默认允许 + 对已知上游域名强制 HTTPS」：
  - base-config 保留 cleartextTrafficPermitted="true"，局域网后端照旧能用；
  - 四家上游（WorkBuddy / Trae / Qoder / MiniMax）逐个声明 cleartextTrafficPermitted="false"，
    即使 config.json 里的地址被改成 http://api.trae.cn 之类的降级地址，系统层也会直接拒绝，
    避免凭据在明文通道里裸奔。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">codebuddy.cn</domain>
        <domain includeSubdomains="true">workbuddy.cn</domain>
        <domain includeSubdomains="true">workbuddy.ai</domain>
        <domain includeSubdomains="true">copilot.tencent.com</domain>
        <domain includeSubdomains="true">trae.cn</domain>
        <domain includeSubdomains="true">trae.ai</domain>
        <domain includeSubdomains="true">qoder.com.cn</domain>
        <domain includeSubdomains="true">qoder.sh</domain>
        <domain includeSubdomains="true">minimax.cn</domain>
        <domain includeSubdomains="true">minimaxi.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
